<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.mohamedsalah13</groupId>
        <artifactId>backup-manager-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>backup-manager-spring-boot-starter</artifactId>
    <name>Backup Manager :: Spring Boot Starter</name>
    <description>Auto-configuration, application.yml binding and Actuator health for the backup manager</description>

    <dependencies>
        <dependency>
            <groupId>io.github.mohamedsalah13</groupId>
            <artifactId>backup-manager-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.mohamedsalah13</groupId>
            <artifactId>backup-manager-db-mysql</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.mohamedsalah13</groupId>
            <artifactId>backup-manager-db-file</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.mohamedsalah13</groupId>
            <artifactId>backup-manager-storage-s3</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.mohamedsalah13</groupId>
            <artifactId>backup-manager-storage-gdrive</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.mohamedsalah13</groupId>
            <artifactId>backup-manager-storage-dropbox</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-actuator</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
